# Provider: auto | mock | openai
# auto uses openai if LLM_API_KEY is set, else mock
LLM_PROVIDER=auto

# OpenAI-compatible endpoint (OpenAI, Grok, local vLLM, etc.)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Host
HOST_PORT=8080
HOST_API_KEY=change-me
LOG_LEVEL=info

# Workers
WORKER_CONCURRENCY=4
JOB_MAX_ITERATIONS=12
JOB_MAX_COST_USD=1.00
