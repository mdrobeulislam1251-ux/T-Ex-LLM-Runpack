# Secrets — never commit credential values
.env
.env.*
!.env.example
companies/*/secrets*

# Fleet — real filled-in registry stays local; only the .example placeholder is committed
fleet-registry.json
**/fleet-registry.json
templates/fleet-registry.json
ssh-config
!templates/ssh-config.example

# Python
__pycache__/
*.pyc
.pytest_cache/

# Node
node_modules/

# Chat-brain local logs (hooks/chat-capture.mjs) — turn memory stays local
**/.claude/chat-log.jsonl
**/.claude/chat-log.cursor

# OS/editor noise
.DS_Store
Thumbs.db

# standalone launcher home: Claude Code writes its runtime state here (including
# .credentials.json OAuth tokens) — track ONLY the two authored files. skills/ is
# mirrored from plugins/tex-llm/skills at launch.
launcher/.claude-tex/*
!launcher/.claude-tex/CLAUDE.md
!launcher/.claude-tex/settings.json
