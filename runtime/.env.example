# === Network (default product port 3006) ===
HOST_PORT=3006
HOST_BIND=0.0.0.0
HOST_API_KEY=change-me
SERVE_WEB=true
WEB_DIST_DIR=apps/web/dist

# Local terminal agent CLI spawn (uses CLI logins, not LLM_API_KEY)
ALLOW_LOCAL_CLI=true
LOCAL_CLI_TIMEOUT_SEC=180
LOCAL_CLI_CWD=.

# OpenClaw-style Codex (ChatGPT) OAuth PKCE — optional
# CODEX_OAUTH_CLIENT_ID=
# CODEX_OAUTH_REDIRECT_URI=http://127.0.0.1:3006/v1/auth/oauth/codex/callback

# Google OAuth for Gemini — optional
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:3006/v1/auth/oauth/google/callback


# Provider: auto | mock | openai  (team runner HTTP path)
LLM_PROVIDER=auto
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

LOG_LEVEL=info
WORKER_CONCURRENCY=4
JOB_MAX_ITERATIONS=12
JOB_MAX_COST_USD=1.00
