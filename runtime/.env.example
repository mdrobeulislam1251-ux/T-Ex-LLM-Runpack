# === Network (default product port 3006) ===
HOST_PORT=3006
HOST_BIND=0.0.0.0
HOST_API_KEY=change-me
SERVE_WEB=true
WEB_DIST_DIR=apps/web/dist

# Local terminal agent CLI spawn (uses CLI logins, not LLM_API_KEY)
ALLOW_LOCAL_CLI=true
LOCAL_CLI_TIMEOUT_SEC=180
LOCAL_CLI_CWD=.

# OpenClaw-style Codex (ChatGPT) OAuth PKCE — optional
# CODEX_OAUTH_CLIENT_ID=
# CODEX_OAUTH_REDIRECT_URI=http://127.0.0.1:3006/v1/auth/oauth/codex/callback

# Google OAuth for Gemini — optional
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:3006/v1/auth/oauth/google/callback


# Provider: auto | mock | openai  (team runner HTTP path)
LLM_PROVIDER=auto
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

LOG_LEVEL=info
WORKER_CONCURRENCY=4
JOB_MAX_ITERATIONS=12
JOB_MAX_COST_USD=1.00

# === Messaging channels (docs/CHANNELS.md) — names here, VALUES stay in .env ===
# Freeform chat text becomes a draft run on this team ("" = reply with help)
CHANNELS_DEFAULT_TEAM=
# Comma-separated import paths of third-party adapter modules (self-register)
CHANNEL_PLUGINS=

# Telegram — quickstart: only BOT_TOKEN + ALLOWED_SENDERS, then `tex channels poll telegram`
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_SENDERS=
# TELEGRAM_POLL_ON_SERVE=false

# WhatsApp (Meta Cloud API) — webhook mode only, needs public HTTPS
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ALLOWED_SENDERS=

# Google Chat app — sync replies; optional space incoming-webhook for pushes
GOOGLE_CHAT_PROJECT_NUMBER=
GOOGLE_CHAT_ALLOWED_SENDERS=
GOOGLE_CHAT_SPACE_WEBHOOK_URL=

# iMessage via BlueBubbles server (runs on a Mac; unofficial — see docs)
BLUEBUBBLES_URL=
BLUEBUBBLES_PASSWORD=
BLUEBUBBLES_ALLOWED_SENDERS=

# Custom HMAC webhook channel (generic integration point)
CUSTOM_CHANNEL_SECRET=
CUSTOM_CHANNEL_ALLOWED_SENDERS=
