# /etc/tex-agent-runner.env  (mode 600, owned by root)  — NO secrets in git; this is the template.
# The installer generates RUNNER_TOKEN and copies TEX_GATEWAY_TOKEN from the n8n .env.
RUNNER_BIND=0.0.0.0
# 8799 on aidata — 8787 is taken by the ES→Supabase transfer-api. n8n reaches this via
# the docker bridge (172.18.0.1) once ufw allows 172.18.0.0/16 → this port.
RUNNER_PORT=8799
RUNNER_TOKEN=__generated_by_installer__
# Report back to Linear THROUGH the gateway (runner never holds the Linear key):
N8N_BASE=http://127.0.0.1:5678
TEX_GATEWAY_TOKEN=__copied_from_n8n__
# What to work on:
REPO_URL=https://github.com/mdrobeulislam1251-ux/T-Ex-LLM-Runpack.git
DEFAULT_BASE_BRANCH=main
# Optional — a fine-grained GitHub token (contents:write on the repo) enables branch PUSH.
# Leave blank and the runner still fixes + commits locally and comments the summary back.
GH_TOKEN=
# REQUIRED to actually run Claude on your Max 20x plan. Get it with, as the texagent user:
#     sudo -u texagent claude setup-token
# then paste the token here. (No API key = no credits burned; billed to the subscription.)
CLAUDE_CODE_OAUTH_TOKEN=
